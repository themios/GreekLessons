# Google Generative AI API Key
# Get your API key from https://makersuite.google.com/app/apikey
GOOGLE_API_KEY="your-google-api-key-here"

# Base URL for the backend API (used by the frontend)
# For local development, this should point to your local server.
VITE_API_URL="http://localhost:3001/api"

# The origin URL for the frontend application (used by CORS)
# In production, this should be the actual URL of your deployed frontend.
CORS_ORIGIN="http://localhost:4100"
